# Bu dosyayı ".env" adıyla kopyalayın; gerçek anahtarları yalnızca kendi bilgisayarınızda tutun.
# Uygulamadaki "Asistan ayarları" penceresi bu değerleri sizin için yazar.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
# classic | realtime | live
CONVERSATION_MODE=classic
RT_MODEL=gpt-realtime-1.5
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
# GPT-Live bilgi sorularını dil modeliyle cevaplasın: client | off
LIVE_DELEGATION=client
OWNER_NAME=
GREETING_TEXT=
# Rehber adı=Hitap; ör. Anne=Ayşe Hanım
HITAP=
